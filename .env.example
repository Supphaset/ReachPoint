# Architecture is set in docs/decisions/0009 (Cloud Run, Firestore, Vertex AI, Maps).
# Add variable names with safe placeholders as code needs them; real values live
# in Secret Manager or an untracked .env.
# Never put credentials, real project/account identifiers or personal details here.

# Optional local caller conversation/location credentials. Load with uvicorn --env-file .env.
# GEMINI_API_KEY=YOUR_GEMINI_KEY
# PINPOINT_API_KEY=YOUR_PINPOINT_KEY
# PINPOINT_REFERER=https://pin-point.co

# Optional server-side full-address lookup. Keep disabled until Maps API access/billing is approved.
# GOOGLE_MAPS_API_KEY=YOUR_SERVER_KEY
REACHPOINT_MAPS_GEOCODING=off
