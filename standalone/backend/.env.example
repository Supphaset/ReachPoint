GEMINI_API_KEY=
# Use a GCP Agent Platform API key with the Vertex AI endpoint.
# The key's owning project is used for billing.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=

GEMINI_MODEL=gemini-3.8-flash
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_LOCATION=us-central1

# Server-side Pinpoint address lookup. Referer must exactly match your key's setting.
PINPOINT_API_KEY=
PINPOINT_REFERER=https://pin-point.co
